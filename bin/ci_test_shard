#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "optparse"
require_relative "../lib/ci/test_shard"

options = {
  shard_index: Integer(ENV.fetch("CI_TEST_SHARD_INDEX", "0")),
  shard_count: Integer(ENV.fetch("CI_TEST_SHARD_COUNT", "1"))
}

OptionParser.new do |parser|
  parser.on("--shard-index INDEX", Integer, "Zero-based shard index") { |value| options[:shard_index] = value }
  parser.on("--shard-count COUNT", Integer, "Total number of shards") { |value| options[:shard_count] = value }
end.parse!

files, status = Open3.capture2("git", "ls-files", "--", "test/**/*_test.rb")
abort "Unable to discover tracked test files" unless status.success?

files = files.lines(chomp: true)
weights = files.to_h { |path| [ path, File.size(path) ] }

selected_files = Ci::TestShard.new(
  files:,
  weights:,
  shard_index: options.fetch(:shard_index),
  shard_count: options.fetch(:shard_count)
).files

puts selected_files
