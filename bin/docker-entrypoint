#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare

  # Render preview roles share one database, so Rails skips their auxiliary
  # schema files after the primary schema creates the shared migrations table.
  # Load each auxiliary schema only when its sentinel table is absent so
  # restarts preserve queue, cache, and cable data.
  prepare_preview_schema() {
    local database="$1"
    local table="$2"
    local table_exists

    table_exists="$(psql "$RENDER_PREVIEW_DATABASE_URL" --tuples-only --no-align --quiet \
      --command "SELECT to_regclass('public.${table}') IS NOT NULL")"
    if [ "$table_exists" != "t" ]; then
      DISABLE_DATABASE_ENVIRONMENT_CHECK=1 SCHEMA_FORMAT=ruby \
        SCHEMA="db/${database}_schema.rb" ./bin/rails "db:schema:load:${database}"
    fi
  }

  if [ "${RENDER_PREVIEW}" == "true" ]; then
    prepare_preview_schema "cache" "solid_cache_entries"
    prepare_preview_schema "queue" "solid_queue_recurring_tasks"
    prepare_preview_schema "cable" "solid_cable_messages"

    # Free Render services do not support one-off shell jobs. The canonical
    # seed is idempotent, so run it on preview boot to repopulate a recreated
    # database without requiring paid Shell access.
    ./bin/rails db:seed
  fi
fi

exec "${@}"
