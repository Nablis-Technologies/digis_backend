#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  if [ "${RENDER_PREVIEW}" == "true" ]; then
    local db_url="${RENDER_PREVIEW_DATABASE_URL:-$DATABASE_URL}"
    if [ -n "$db_url" ]; then
      local has_digest_col
      has_digest_col="$(psql "$db_url" --tuples-only --no-align --quiet \
        --command "SELECT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'marketplace_seller_payout_accounts' AND column_name = 'account_number_digest')" 2>/dev/null || true)"
      if [ "$has_digest_col" != "t" ]; then
        echo "Aligning marketplace seller payout accounts schema..."
        psql "$db_url" --quiet --command "
          DROP TABLE IF EXISTS marketplace_seller_payout_allocations CASCADE;
          DROP TABLE IF EXISTS marketplace_seller_payouts CASCADE;
          DROP TABLE IF EXISTS marketplace_seller_payout_accounts CASCADE;
          DELETE FROM schema_migrations WHERE version IN ('20260814090001', '20260814090005', '20260814090006');
        " 2>/dev/null || true
      fi
    fi
    # db:prepare seeds a brand-new database before the shared queue schema is
    # available. Preview migrations and fixture seeding therefore run in order.
    ./bin/rails db:migrate
  else
    ./bin/rails db:prepare
  fi

  # Render preview roles share one database, so Rails skips their auxiliary
  # schema files after the primary schema creates the shared migrations table.
  # Load each auxiliary schema only when its sentinel table is absent so
  # restarts preserve queue, cache, and cable data.
  prepare_preview_schema() {
    local database="$1"
    local table="$2"
    local table_exists

    table_exists="$(psql "$RENDER_PREVIEW_DATABASE_URL" --tuples-only --no-align --quiet \
      --command "SELECT to_regclass('public.${table}') IS NOT NULL")"
    if [ "$table_exists" != "t" ]; then
      DISABLE_DATABASE_ENVIRONMENT_CHECK=1 SCHEMA_FORMAT=ruby \
        SCHEMA="db/${database}_schema.rb" ./bin/rails "db:schema:load:${database}"
    fi
  }

  preview_seed_required() {
    local users_exist

    if [ "${DIGIS_FORCE_SEED}" == "true" ]; then
      return 0
    fi

    users_exist="$(psql "$RENDER_PREVIEW_DATABASE_URL" --tuples-only --no-align --quiet \
      --command "SELECT EXISTS (SELECT 1 FROM public.core_users)")"
    [ "$users_exist" != "t" ]
  }

  reset_preview_database() {
    if [ "${DIGIS_RESET_DATABASE}" != "true" ]; then
      return 1
    fi

    if [ -z "${RENDER_PREVIEW_DATABASE_URL}" ]; then
      echo "DIGIS_RESET_DATABASE=true requires RENDER_PREVIEW_DATABASE_URL" >&2
      exit 1
    fi

    echo "Resetting the disposable Render preview database and rebuilding its seed"
    DISABLE_DATABASE_ENVIRONMENT_CHECK=1 ./bin/rails db:seed:replant
    return 0
  }

  if [ "${RENDER_PREVIEW}" == "true" ]; then
    prepare_preview_schema "cache" "solid_cache_entries"
    prepare_preview_schema "queue" "solid_queue_recurring_tasks"
    prepare_preview_schema "cable" "solid_cable_messages"

    # Free Render services do not support one-off shell jobs. A reset is
    # explicitly opt-in and guarded to the disposable preview database.
    # Ordinary restarts skip the memory-heavy fixture graph.
    if reset_preview_database; then
      :
    elif preview_seed_required; then
      ./bin/rails db:seed
    else
      echo "Preview database already initialized; skipping preview seed"
    fi
  fi
fi

exec "${@}"
