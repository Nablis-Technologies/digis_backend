# PostgreSQL Configuration
# =======================
# Database connection settings for production environment.
# All values have sensible defaults except DIGIS_BACKEND_DATABASE_PASSWORD.

# Primary database
DIGIS_BACKEND_DATABASE=digis_backend_production
DIGIS_BACKEND_DATABASE_USERNAME=digis_backend
DIGIS_BACKEND_DATABASE_PASSWORD=       # REQUIRED - no default
DIGIS_BACKEND_DATABASE_HOST=localhost
DIGIS_BACKEND_DATABASE_PORT=5432

# Cache database (uses same credentials as primary by default)
DIGIS_BACKEND_CACHE_DATABASE=digis_backend_production_cache

# Queue database (uses same credentials as primary by default)
DIGIS_BACKEND_QUEUE_DATABASE=digis_backend_production_queue

# Cable database (uses same credentials as primary by default)
DIGIS_BACKEND_CABLE_DATABASE=digis_backend_production_cable

# Rails Configuration
# ==================
RAILS_ENV=production
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info

# Secret Key Base
# ==============
# Use `rails secret` to generate a new secret key base
# RAILS_MASTER_KEY=<your-master-key-here>

# Optional: Override DATABASE_URL for full connection string control
# DATABASE_URL=postgres://username:password@host:port/database_name

# Public and branded links (dig.is)
# =================================
# Branded short-links are opt-in. When false, falls back to direct signed URLs.
SHORT_LINKS_ENABLED=false
SHORT_LINKS_HOST=dig.is
SHORT_LINKS_PROTOCOL=https
# Leave blank for standard production ports (80/443); set to 3000 for local dev.
# SHORT_LINKS_PORT=3000

# Public application URL (REQUIRED in production).
# Where public-facing pages (like /public/tickets/:id) live.
# NOTE: Replace with your actual production application origin.
PUBLIC_APP_URL=https://app.digis.com

# ==============================================================================
# Development & Testing Recipes
# ==============================================================================

# Recipe 1: Standard Local Development (Zero-Config Default)
# ---------------------------------------------------------
# Out-of-the-box local development. No short links or preview flags needed.
# Guest checkout automatically falls back to direct signed URLs under localhost:3000:
#
# (No extra variables needed — PUBLIC_APP_URL defaults to http://localhost:3000 in dev/test)

# Recipe 2: Local Preview-Mode Testing (Simulated SMS & Console OTP)
# -----------------------------------------------------------------
# Runs local development in preview-mode so the preview debug sender exposes
# OTP codes and SMS bodies directly in your Rails terminal console without
# needing real SMS gateway credentials.
#
# SHORT_LINKS_ENABLED=true
# SHORT_LINKS_HOST=localhost
# SHORT_LINKS_PORT=3000
# SHORT_LINKS_PROTOCOL=http
# PUBLIC_APP_URL=http://localhost:3000
# RENDER_PREVIEW=true
# DIGIS_MESSAGING_PREVIEW_PROVIDER=true
# DIGIS_MESSAGING_PREVIEW_OUTCOME=delivered
# DIGIS_PREVIEW_DEBUG_LOGGING=true

# Recipe 3: Render Preview Environment (Frontend PR Testing)
# ----------------------------------------------------------
# Set these on the Render preview service dashboard for frontend smoke tests.
# NOTE: Replace <your-render-service> with your actual preview service subdomain.
#
# SHORT_LINKS_ENABLED=true
# SHORT_LINKS_HOST=<your-render-service>.onrender.com
# SHORT_LINKS_PROTOCOL=https
# PUBLIC_APP_URL=https://<your-render-service>.onrender.com
# RENDER_PREVIEW=true
# DIGIS_MESSAGING_PREVIEW_PROVIDER=true
# DIGIS_MESSAGING_PREVIEW_OUTCOME=delivered
# DIGIS_PREVIEW_DEBUG_LOGGING=true
