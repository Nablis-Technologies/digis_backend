        },
        {
          "name": "Combined: city filter + q search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/venues?city=Addis+Ababa&q[name_cont]=sheraton",
              "host": ["{{baseUrl}}"],
              "path": ["venues"],
              "query": [
                { "key": "city", "value": "Addis Ababa" },
                { "key": "q[name_cont]", "value": "sheraton" }
              ]
            }
          }
        },
        {
          "name": "Sort by name asc, paginated",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/venues?order_by=name&order_direction=asc&page=1&per_page=2",
              "host": ["{{baseUrl}}"],
              "path": ["venues"],
              "query": [
                { "key": "order_by", "value": "name" },
                { "key": "order_direction", "value": "asc" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "2" }
              ]
            }
          }
        },
        {
          "name": "Unfiltered list with pagination metadata",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/venues?page=1",
              "host": ["{{baseUrl}}"],
              "path": ["venues"],
              "query": [
                { "key": "page", "value": "1" }
              ]
            }
          }
        }
