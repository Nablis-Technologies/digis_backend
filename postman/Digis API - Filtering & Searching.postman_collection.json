{
  "info": {
    "name": "Digis API — Filtering & Searching",
    "description": "Filtering, searching, pagination, and sorting examples for all endpoints. Works with seed data.\n\n1. Run \"Login\" requests first to set the access token\n2. Public endpoints don't need auth (but work with it too)\n3. Admin/Owner endpoints need a logged-in admin user\n\nSee docs/API_FILTERING_AND_SEARCHING.md for full documentation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "▶️ Auth — Login First",
      "description": "Run one of these to set the access token. Public endpoints don't need auth, but admin endpoints do.",
      "item": [
        {
          "name": "Login as Admin (SUPER_ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"+251911000001\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login as SUPER_ADMIN (admin@digis.et). Sets the access token for all subsequent requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const token = json?.data?.access_token;",
                  "  if (token) pm.collectionVariables.set(\"accessToken\", token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login as Organizer (CORE_ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"+251911000002\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login as CORE_ADMIN (organizer@digis.et). Has limited admin access."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const token = json?.data?.access_token;",
                  "  if (token) pm.collectionVariables.set(\"accessToken\", token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🌐 Public — Categories",
      "item": [
        {
          "name": "List categories (default)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Search by name: q[name_cont]=music",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories?q[name_cont]=music",
              "host": ["{{baseUrl}}"],
              "path": ["categories"],
              "query": [
                { "key": "q[name_cont]", "value": "music" }
              ]
            }
          }
        },
        {
          "name": "Sort alphabetically: order_by=name&order_direction=asc",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories?order_by=name&order_direction=asc",
              "host": ["{{baseUrl}}"],
              "path": ["categories"],
              "query": [
                { "key": "order_by", "value": "name" },
                { "key": "order_direction", "value": "asc" }
              ]
            }
          }
        }
      ]
    },
    {
