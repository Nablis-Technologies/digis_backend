module <%= namespace_path.camelize %>
  class <%= model_name %>Policy < Core::ApplicationPolicy
    def index?
      true
    end

    def show?
      true
    end

    def create?
      user.has_role?("SUPER_ADMIN") || user.has_role?("ADMIN")
    end

    def update?
      user.has_role?("SUPER_ADMIN") || user.has_role?("ADMIN")
    end

    def destroy?
      user.has_role?("SUPER_ADMIN")
    end

    VISIBILITY = {}.freeze

    class Scope < Core::ApplicationPolicy::Scope
      def resolve
        scope.all
      end
    end
  end
end
